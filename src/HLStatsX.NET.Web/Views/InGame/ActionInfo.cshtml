@model InGameActionInfoViewModel
@using HLStatsX.NET.Web.Models.ViewModels
@{
    Layout = "~/Views/Shared/_InGameLayout.cshtml";
    ViewData["Title"] = Model.ActionDescription + " — Players";

    string SortUrl(string field)
    {
        bool nd = Model.SortBy == field ? !Model.Desc : true;
        return Url.Action("ActionInfo", "InGame", new { game = Model.Game, action = Model.ActionCode, sortBy = field, desc = nd, page = 1 })!;
    }
    string Mark(string field) => Model.SortBy == field ? (Model.Desc ? " ▼" : " ▲") : "";

    var flagBase = Url.Content("~/hlstatsimg/flags");
    string FlagImg(string? flag) =>
        $"<img src=\"{flagBase}/{(string.IsNullOrEmpty(flag) ? "0" : flag.ToLowerInvariant())}.gif\" alt=\"\" />";

    int startRank = (Model.Page - 1) * Model.Achievers.PageSize + 1;
}

<table class="data-table">
    <tr class="data-table-head">
        <td colspan="4">&nbsp;@Model.ActionDescription</td>
    </tr>
    <tr class="data-table-head">
        <td style="text-align:right;">Rank</td>
        <td><a href="@SortUrl("name")">Player@(Mark("name"))</a></td>
        <td style="text-align:right;"><a href="@SortUrl("count")">Count@(Mark("count"))</a></td>
        <td style="text-align:right;"><a href="@SortUrl("bonus")">Skill Bonus@(Mark("bonus"))</a></td>
    </tr>
    @{ int rowNum = startRank; }
    @foreach (var a in Model.Achievers.Items)
    {
        <tr class="@(rowNum % 2 == 1 ? "bg1" : "bg2")">
            <td style="text-align:right;">@rowNum</td>
            <td>@Html.Raw(FlagImg(a.Flag)) <a href="@Url.Action("PlayerStats", "InGame", new { game = Model.Game, player = a.PlayerId })">@a.PlayerName</a></td>
            <td style="text-align:right;">@a.Count.ToString("N0")</td>
            <td style="text-align:right;">@a.SkillBonusTotal.ToString("N0")</td>
        </tr>
        rowNum++;
    }
</table>

@if (Model.Achievers.TotalPages > 1)
{
    <div style="padding:4px;">
        @if (Model.Achievers.HasPreviousPage)
        {
            <a href="@Url.Action("ActionInfo", "InGame", new { game = Model.Game, action = Model.ActionCode, sortBy = Model.SortBy, desc = Model.Desc, page = Model.Page - 1 })">« Prev</a>
        }
        &nbsp;Page @Model.Page of @Model.Achievers.TotalPages&nbsp;
        @if (Model.Achievers.HasNextPage)
        {
            <a href="@Url.Action("ActionInfo", "InGame", new { game = Model.Game, action = Model.ActionCode, sortBy = Model.SortBy, desc = Model.Desc, page = Model.Page + 1 })">Next »</a>
        }
    </div>
}
