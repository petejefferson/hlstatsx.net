@model CountryProfileViewModel
@using HLStatsX.NET.Core.Models
@{
    ViewData["Title"] = Model.Profile.Name + " — Country";

    string SortUrl(string field)
    {
        bool nextDesc = Model.SortBy == field ? !Model.Descending : true;
        return Url.Action("Profile", new { flag = Model.Profile.Flag, game = Model.Game, sortBy = field, desc = nextDesc })!;
    }
    string Mark(string field) => Model.SortBy == field ? (Model.Descending ? " ▼" : " ▲") : "";

    var flagLower = Model.Profile.Flag.ToLowerInvariant();
    var hasLocations = Model.MemberLocations.Count > 0;
    var locJson = "[]";

    if (hasLocations)
    {
        var locGroups = Model.MemberLocations
            .GroupBy(p => (p.Lat, p.Lng))
            .Select(g => new {
                lat     = g.Key.Lat,
                lng     = g.Key.Lng,
                city    = g.First().City    ?? "",
                country = g.First().Country ?? "",
                players = g.Select(p => new { id = p.PlayerId, name = p.LastName, kills = p.Kills, deaths = p.Deaths }).ToList()
            })
            .ToList();
        locJson = System.Text.Json.JsonSerializer.Serialize(locGroups);
    }
}

<h1>
    <img src="@(Url.Content("~/hlstatsimg/flags/") + flagLower + ".gif")" alt="@Model.Profile.Name" title="@Model.Profile.Name" style="vertical-align:middle;" />
    @Model.Profile.Name
</h1>

<div style="display:flex; gap:1rem; flex-wrap:wrap; margin-bottom:1rem;">
    <div style="flex:1; min-width:280px;">
        <table class="data-table">
            <tr class="data-table-head">
                <td colspan="2">Statistics Summary</td>
            </tr>
            <tr class="bg1">
                <td style="width:45%;">Country:</td>
                <td><strong>@Model.Profile.Name</strong></td>
            </tr>
            <tr class="bg2">
                <td>Activity:</td>
                <td>
                    <activity-meter value="@Model.Profile.AvgActivity" />
                    @Model.Profile.AvgActivity.ToString("F2")%
                </td>
            </tr>
            <tr class="bg1">
                <td>Members:</td>
                <td><strong>@Model.Profile.MemberCount</strong> active members</td>
            </tr>
            <tr class="bg2">
                <td>Total Kills:</td>
                <td>@Model.Profile.TotalKills.ToString("N0")</td>
            </tr>
            <tr class="bg1">
                <td>Total Deaths:</td>
                <td>@Model.Profile.TotalDeaths.ToString("N0")</td>
            </tr>
            <tr class="bg2">
                <td>Avg. Kills:</td>
                <td>@Model.Profile.AvgKills.ToString("N0")</td>
            </tr>
            <tr class="bg1">
                <td>Kills per Death:</td>
                <td>
                    @if (Model.Profile.TotalDeaths != 0)
                    {
                        <strong>@Model.Profile.KillDeathRatio.ToString("F2")</strong>
                    }
                    else
                    {
                        <text>-</text>
                    }
                </td>
            </tr>
            <tr class="bg2">
                <td>Kills per Minute:</td>
                <td>
                    @if (Model.Profile.TotalConnectionTime > 0)
                    {
                        @Model.Profile.KillsPerMinute.ToString("F2")
                    }
                    else
                    {
                        <text>-</text>
                    }
                </td>
            </tr>
            <tr class="bg1">
                <td>Avg. Member Points:</td>
                <td><strong>@Model.Profile.AvgSkill.ToString("N0")</strong></td>
            </tr>
            <tr class="bg2">
                <td>Avg. Connection Time:</td>
                <td>
                    @if (Model.Profile.TotalConnectionTime > 0)
                    {
                        @RazorHelpers.FormatTime(Model.Profile.AvgConnectionTime)
                    }
                    else
                    {
                        <text>-</text>
                    }
                </td>
            </tr>
            <tr class="bg1">
                <td>Total Connection Time:</td>
                <td>@RazorHelpers.FormatTime(Model.Profile.TotalConnectionTime)</td>
            </tr>
        </table>
    </div>
    <div style="flex:0 0 auto; text-align:center; padding-top:2rem;">
        <img src="@(Url.Content("~/hlstatsimg/flags/") + flagLower + "_large.png")"
             alt="@Model.Profile.Name"
             data-fallback="@(Url.Content("~/hlstatsimg/flags/") + flagLower + ".gif")"
             onerror="this.src=this.dataset.fallback; this.onerror=null;"
             style="border:0;" />
    </div>
</div>

@if (hasLocations)
{
    <div style="margin-bottom:1rem;">
        <table class="data-table">
            <tr class="data-table-head"><th>Player Locations</th></tr>
            <tr class="bg1">
                <td style="padding:0;">
                    <div id="player-map" style="width:100%;height:320px;"></div>
                </td>
            </tr>
        </table>
    </div>
}

<h2>Members (@Model.Members.TotalCount)</h2>

<table class="data-table">
    <thead>
        <tr class="data-table-head">
            <th style="text-align:right;">Rank</th>
            <th style="text-align:right;">Rank #</th>
            <th style="text-align:left;"><a href="@(SortUrl("name"))">Name@(Mark("name"))</a></th>
            <th style="text-align:right;"><a href="@(SortUrl("skill"))">Points@(Mark("skill"))</a></th>
            <th style="text-align:center;">Activity</th>
            <th style="text-align:right;"><a href="@(SortUrl("connection_time"))">Time@(Mark("connection_time"))</a></th>
            <th style="text-align:right;"><a href="@(SortUrl("kills"))">Kills@(Mark("kills"))</a></th>
            <th style="text-align:center;">Country Kills %</th>
            <th style="text-align:right;">%</th>
            <th style="text-align:right;"><a href="@(SortUrl("deaths"))">Deaths@(Mark("deaths"))</a></th>
            <th style="text-align:right;"><a href="@(SortUrl("kpd"))">K:D@(Mark("kpd"))</a></th>
        </tr>
    </thead>
    <tbody>
        @{
            bool alt = false;
            int rowNum = (Model.Members.Page - 1) * Model.Members.PageSize + 1;
        }
        @foreach (var m in Model.Members.Items)
        {
            string rowClass = (alt = !alt) ? "bg1" : "bg2";
            var memberFlag = string.IsNullOrEmpty(m.Flag) ? "0" : m.Flag.ToLowerInvariant();
            <tr class="@rowClass">
                <td style="text-align:right;">@(rowNum++)</td>
                <td style="text-align:right;">@(m.MmRank.HasValue ? m.MmRank.Value.ToString("N0") : "-")</td>
                <td>
                    <img src="@(Url.Content("~/hlstatsimg/flags/") + memberFlag + ".gif")" alt="@m.Country" title="@m.Country" />
                    &nbsp;<a asp-controller="Players" asp-action="Profile" asp-route-id="@m.PlayerId">@m.Name</a>
                </td>
                <td style="text-align:right;">@m.Skill.ToString("N0")</td>
                <td style="text-align:center;">
                    <activity-meter value="@m.Activity" title="@m.Activity.ToString("F2")%" />
                </td>
                <td style="text-align:right;">@RazorHelpers.FormatTime(m.ConnectionTime)</td>
                <td style="text-align:right;">@m.Kills.ToString("N0")</td>
                <td style="text-align:center;">
                    <activity-meter value="@m.KillPercent" title="@m.KillPercent.ToString("F2")%" />
                </td>
                <td style="text-align:right;">@m.KillPercent.ToString("F2")%</td>
                <td style="text-align:right;">@m.Deaths.ToString("N0")</td>
                <td style="text-align:right;">@m.KillDeathRatio.ToString("F2")</td>
            </tr>
        }
        @if (!Model.Members.Items.Any())
        {
            <tr><td colspan="11" style="text-align:center;">No members found.</td></tr>
        }
    </tbody>
</table>

<partial name="_Pagination" model="@PaginationModel.From(Model.Members, p => Url.Action("Profile", new { flag = Model.Profile.Flag, game = Model.Game, sortBy = Model.SortBy, desc = Model.Descending, page = p })!)" />

@section Styles {
    @if (hasLocations)
    {
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    }
}

@section Scripts {
    @if (hasLocations)
    {
        var profileBase = Url.Action("Profile", "Players");
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
        <script>
            (function () {
                var locations = @Html.Raw(locJson);
                var profileBase = '@profileBase';
                var map = L.map('player-map');
                L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    maxZoom: 19,
                    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
                }).addTo(map);

                var markers = [];
                locations.forEach(function (loc) {
                    var locHeader = (loc.city ? loc.city + ', ' : '') + loc.country;
                    var html = '<table style="min-width:160px;"><tr><td colspan="2" style="font-weight:bold;border-bottom:1px solid #ccc;padding-bottom:4px;">' +
                        locHeader + '</td></tr>';
                    loc.players.forEach(function (p) {
                        html += '<tr><td colspan="2"><a href="' + profileBase + '/' + p.id + '">' + p.name + '</a></td></tr>' +
                                '<tr><td style="color:#888;">K/D:&nbsp;</td><td>' + p.kills + '/' + p.deaths + '</td></tr>';
                    });
                    html += '</table>';
                    markers.push(L.marker([loc.lat, loc.lng]).addTo(map).bindPopup(html));
                });

                if (markers.length > 0) {
                    map.fitBounds(L.featureGroup(markers).getBounds().pad(0.3));
                } else {
                    map.setView([25.0, 8.5], 2);
                }
            })();
        </script>
    }
}
