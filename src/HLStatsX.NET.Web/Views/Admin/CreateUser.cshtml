@model CreateAdminUserViewModel
@{
    ViewData["Title"] = "Create Admin User";
    Layout = "_AdminLayout";
}

<h1>Create Admin User</h1>

<form asp-action="CreateUser" method="post" style="max-width:480px;">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert-danger"></div>
    <div class="form-group">
        <label asp-for="Username">Username</label>
        <input asp-for="Username" type="text" maxlength="16" />
        <span asp-validation-for="Username" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Password">Password</label>
        <input asp-for="Password" type="password" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="ConfirmPassword">Confirm Password</label>
        <input asp-for="ConfirmPassword" type="password" />
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="AccLevel">Access Level</label>
        <select asp-for="AccLevel">
            <option value="100">Administrator</option>
            <option value="80">Restricted</option>
            <option value="0">No Access</option>
        </select>
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Create User</button>
        <a asp-action="Users" class="btn btn-secondary" style="margin-left:8px;">Cancel</a>
    </div>
</form>
