@model HLStatsX.NET.Core.Entities.VoiceCommServer
@{ ViewData["Title"] = $"Edit VoiceComm Server: {Model.Name}"; Layout = "_AdminLayout"; }
<h1>Edit VoiceComm Server</h1>
<form asp-action="EditVoiceCommServer" asp-route-id="@Model.ServerId" method="post" style="max-width:500px">
    @Html.AntiForgeryToken()
    <div class="form-group">
        <label asp-for="ServerType">Server Type</label>
        <select asp-for="ServerType">
            <option value="0" selected="@(Model.ServerType == 0)">TeamSpeak</option>
            <option value="1" selected="@(Model.ServerType == 1)">Ventrilo</option>
        </select>
    </div>
    <div class="form-group">
        <label asp-for="Name">Server Name</label>
        <input asp-for="Name" type="text" maxlength="64" required />
        <span asp-validation-for="Name" style="color:red;font-size:11px;"></span>
    </div>
    <div class="form-group">
        <label asp-for="Addr">Server IP or Hostname</label>
        <input asp-for="Addr" type="text" maxlength="64" required />
    </div>
    <div class="form-group">
        <label asp-for="Password">Password</label>
        <input asp-for="Password" type="text" maxlength="64" />
    </div>
    <div class="form-group">
        <label asp-for="UdpPort">UDP Port (TeamSpeak only)</label>
        <input asp-for="UdpPort" type="number" min="0" max="65535" style="width:100px" />
    </div>
    <div class="form-group">
        <label asp-for="QueryPort">Query Port (TS) / Connect Port (Ventrilo)</label>
        <input asp-for="QueryPort" type="number" min="0" max="65535" style="width:100px" />
    </div>
    <div class="form-group">
        <label asp-for="Description">Notes</label>
        <input asp-for="Description" type="text" maxlength="128" style="width:300px" />
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-action="VoiceCommServers" class="btn btn-secondary">Cancel</a>
    </div>
</form>
