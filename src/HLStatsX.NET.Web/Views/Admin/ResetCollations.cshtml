@model HLStatsX.NET.Web.Models.ViewModels.ResetCollationsViewModel
@{ ViewData["Title"] = "Reset DB Collations"; Layout = "_AdminLayout"; }
<h1>Reset DB Collations</h1>

@if (Model.Log != null)
{
    @if (Model.PrintOnly)
    {
        <h2>SQL Statements</h2>
        <p>Run these statements against your MySQL database:</p>
        <pre style="background:#f5f5f5;border:1px solid #ddd;padding:12px;overflow-x:auto;font-size:12px;">@foreach (var line in Model.Log) {<text>@line
</text>}</pre>
    }
    else
    {
        <h2>Results</h2>
        <ul>
            @foreach (var line in Model.Log)
            {
                <li>@line</li>
            }
        </ul>
        <p>Done.</p>
    }
    <p><a asp-action="ResetCollations" class="btn btn-secondary">Back</a></p>
}
else
{
    <form asp-action="ResetCollations" method="post" style="max-width:600px">
        @Html.AntiForgeryToken()
        <div class="note-box">
            Resets DB collations if you get collation errors after an upgrade from another HLstats(X)-based system.
            Converts all tables and columns to <strong>utf8mb4 / utf8mb4_unicode_ci</strong>.<br /><br />
            You should not lose any data, but be sure to back up your database before running to be safe.
        </div>
        <div class="form-group" style="margin:16px 0">
            <label>
                <input type="radio" name="PrintOnly" value="false" checked="checked" />
                Run the commands on the database
            </label><br />
            <label>
                <input type="radio" name="PrintOnly" value="true" />
                Print the SQL statements (recommended for very large databases)
            </label>
        </div>
        <button type="submit" class="btn btn-primary">Generate and Execute</button>
    </form>
}
