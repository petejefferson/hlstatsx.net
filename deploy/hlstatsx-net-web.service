[Unit]
Description=HLStatsX.NET Web
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/hlstatsx-net-web

ExecStartPre=/usr/bin/docker compose pull --quiet
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down
ExecReload=/bin/sh -c '/usr/bin/docker compose pull --quiet && /usr/bin/docker compose up -d --remove-orphans'

Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
