# Copy this file to .env and fill in the values before starting the container.
# .env is gitignored and should never be committed.

# MySQL connection string
HLSTATSX_CONNECTION_STRING=Server=localhost;Port=3306;Database=hlstatsx;User=hlstatsx;Password=changeme;CharSet=utf8mb4;

# Site settings
HLSTATSX_DEFAULT_GAME=dods
HLSTATSX_SITE_NAME=HLStatsX.NET

# Steam Web API key (free, from https://steamcommunity.com/dev/apikey) — used for player avatars.
# Leave empty to fall back to scraping steamcommunity.com, which Steam rate-limits (HTTP 429).
HLSTATSX_STEAM_API_KEY=
